# Swapped FortiGate model roles for A/B testing.
# Qwen handles primary generation, builder review, and autonomous repair.
# Gemma handles the independent judge and pre-judge refiner.
MODEL_NAME=Qwen3.6-27B
NETWORK_CHAT_MODEL_NAME=Qwen3.6-27B
NETWORK_INTAKE_MODEL_NAME=Qwen3.6-27B
