#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$HOME/dev/agent-platform"
cd "$PROJECT_DIR"

usage() {
  cat <<USAGE
Usage: agent-platform <command>

Commands:
  start      Start the LangGraph stack
  stop       Stop the LangGraph stack
  restart    Restart the LangGraph stack
  rebuild    Rebuild and restart the LangGraph stack
  status     Show LangGraph/LiteLLM container status
  logs       Tail LangGraph app logs
  health     Check the LangGraph health endpoint
  graph      Print the Mermaid graph source
  open       Print browser URLs for the agent UI endpoints
  frontend   Check the research frontend health endpoint
  model-profile [list|show NAME|apply NAME [--restart]]
             Apply a FortiGate model-role profile from config/model-profiles
  research QUESTION  Run a structured research request
  chat TEXT         Send a quick test message to LangGraph
  thread ID TEXT    Send a message using a checkpointed thread id
USAGE
}

command="${1:-}"
case "$command" in
  start)
    docker-compose up -d
    ;;
  stop)
    docker-compose down
    ;;
  restart)
    docker-compose restart
    ;;
  rebuild)
    docker-compose up -d --build
    ;;
  status)
    docker ps --filter name=langgraph --filter name=litellm --filter name=research-frontend --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
    ;;
  logs)
    docker logs -f langgraph-app
    ;;
  health)
    curl -sS http://localhost:8001/health
    echo
    ;;
  graph)
    curl -sS http://localhost:8001/graph/mermaid
    echo
    ;;
  frontend)
    curl -sS http://localhost:8080/health
    echo
    ;;
  model-profile)
    shift || true
    subcommand="${1:-list}"
    profiles_dir="$PROJECT_DIR/config/model-profiles"
    case "$subcommand" in
      list)
        if [ -d "$profiles_dir" ]; then
          for profile in "$profiles_dir"/*.env; do
            [ -e "$profile" ] || continue
            basename "$profile" .env
          done
        fi
        ;;
      show)
        profile_name="${2:-}"
        if [ -z "$profile_name" ] || [ ! -f "$profiles_dir/$profile_name.env" ]; then
          echo "Missing or unknown model profile: ${profile_name:-<empty>}" >&2
          exit 2
        fi
        cat "$profiles_dir/$profile_name.env"
        ;;
      apply)
        profile_name="${2:-}"
        restart="${3:-}"
        if [ -z "$profile_name" ] || [ ! -f "$profiles_dir/$profile_name.env" ]; then
          echo "Missing or unknown model profile: ${profile_name:-<empty>}" >&2
          exit 2
        fi
        python3 - "$PROJECT_DIR/.env" "$profiles_dir/$profile_name.env" <<'PY'
from __future__ import annotations

from datetime import datetime, timezone
from pathlib import Path
import shutil
import sys

env_path = Path(sys.argv[1])
profile_path = Path(sys.argv[2])
allowed_keys = {
    "MODEL_NAME",
    "NETWORK_CHAT_MODEL_NAME",
    "NETWORK_INTAKE_MODEL_NAME",
    "NETWORK_PACKAGE_MODEL_NAME",
    "NETWORK_HANDOFF_MODEL_NAME",
    "MODEL_TEMPERATURE",
    "NETWORK_CHAT_TEMPERATURE",
    "NETWORK_CHAT_ENABLE_THINKING",
    "NETWORK_INTAKE_TEMPERATURE",
    "NETWORK_PACKAGE_TEMPERATURE",
    "NETWORK_HANDOFF_TEMPERATURE",
    "FORTIGATE_DESIGN_MODEL_NAME",
    "FORTIGATE_INTENT_MODEL_NAME",
    "FORTIGATE_RENDER_MODEL_NAME",
    "FORTIGATE_RENDERER_ENABLED",
    "FORTIGATE_JUDGE_MODEL_NAME",
    "FORTIGATE_BUILDER_REVIEW_MODEL_NAME",
    "FORTIGATE_CONFIG_REFINER_MODEL_NAME",
    "FORTIGATE_AUTONOMOUS_REPAIR_MODEL_NAME",
    "FORTIGATE_AUTONOMOUS_REPAIR_TEMPERATURE",
    "FORTIGATE_ENABLE_THINKING",
    "FORTIGATE_JUDGE_ENABLE_THINKING",
    "FORTIGATE_CONTEXT_FALLBACK_MODEL_NAME",
    "FORTIGATE_CONTEXT_FALLBACK_MAX_OUTPUT_TOKENS",
    "FORTIGATE_CONTEXT_FALLBACK_TEMPERATURE",
    "FORTIGATE_BUILDER_REVIEW_MODE",
    "FORTIGATE_CONFIG_REFINEMENT_MODE",
    "FORTIGATE_BUILDER_REVIEW_TEMPERATURE",
    "FORTIGATE_AUTONOMOUS_REPAIR_LIMIT",
    "MODEL_MAX_OUTPUT_TOKENS",
    "FORTIGATE_GENERATION_MAX_OUTPUT_TOKENS",
    "FORTIGATE_DESIGN_MAX_OUTPUT_TOKENS",
    "FORTIGATE_JUDGE_MAX_OUTPUT_TOKENS",
    "FORTIGATE_BUILDER_REVIEW_MAX_OUTPUT_TOKENS",
    "FORTIGATE_CONFIG_REFINER_MAX_OUTPUT_TOKENS",
    "FORTIGATE_AUTONOMOUS_REPAIR_MAX_OUTPUT_TOKENS",
    "NETWORK_CHAT_MAX_OUTPUT_TOKENS",
    "NETWORK_INTAKE_MAX_OUTPUT_TOKENS",
    "NETWORK_PACKAGE_MAX_OUTPUT_TOKENS",
    "NETWORK_HANDOFF_MAX_OUTPUT_TOKENS",
}

updates: dict[str, str] = {}
for raw_line in profile_path.read_text().splitlines():
    line = raw_line.strip()
    if not line or line.startswith("#"):
        continue
    key, separator, value = line.partition("=")
    if not separator:
        continue
    key = key.strip()
    if key not in allowed_keys:
        raise SystemExit(f"Profile contains unsupported key: {key}")
    updates[key] = value.strip()

if not updates:
    raise SystemExit("Profile did not contain any supported keys.")

timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
backup_path = env_path.with_name(f"{env_path.name}.bak-{timestamp}")
shutil.copy2(env_path, backup_path)

lines = env_path.read_text().splitlines()
seen: set[str] = set()
for index, line in enumerate(lines):
    key, separator, _ = line.partition("=")
    if separator and key in updates:
        lines[index] = f"{key}={updates[key]}"
        seen.add(key)

for key, value in updates.items():
    if key not in seen:
        lines.append(f"{key}={value}")

env_path.write_text("\n".join(lines) + "\n")
print(f"Applied {profile_path.stem}; backup saved to {backup_path}")
PY
        if [ "$restart" = "--restart" ]; then
          docker compose up -d --build langgraph-app
        else
          echo "Restart langgraph-app for changes to take effect, or rerun with --restart."
        fi
        ;;
      *)
        echo "Unknown model-profile command: $subcommand" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  open)
    cat <<URLS
Research UI:    http://localhost:8080
Graph UI:       http://localhost:8001/graph
Mermaid source: http://localhost:8001/graph/mermaid
Research graph: http://localhost:8001/research/graph/mermaid
Health:         http://localhost:8001/health
Langfuse:       http://localhost:3001
URLS
    ;;
  chat)
    shift || true
    message="${*:-Say hello from LangGraph.}"
    python3 - "$message" <<"PY"
import json
import sys
import urllib.request

message = sys.argv[1]
payload = json.dumps({"message": message}).encode()
req = urllib.request.Request(
    "http://localhost:8001/chat",
    data=payload,
    headers={"Content-Type": "application/json"},
    method="POST",
)
with urllib.request.urlopen(req, timeout=60) as response:
    print(response.read().decode())
PY
    ;;
  research)
    shift || true
    question="${*:-What should we research next?}"
    python3 - "$question" <<"PY"
import json
import sys
import urllib.request

question = sys.argv[1]
payload = json.dumps({
    "thread_id": "cli-research",
    "mode": "quick",
    "question": question,
    "constraints": "Use the current local agent platform context.",
}).encode()
req = urllib.request.Request(
    "http://localhost:8001/research",
    data=payload,
    headers={"Content-Type": "application/json"},
    method="POST",
)
with urllib.request.urlopen(req, timeout=120) as response:
    print(response.read().decode())
PY
    ;;
  thread)
    shift || true
    thread_id="${1:-}"
    shift || true
    message="${*:-Say hello from this checkpointed thread.}"
    if [ -z "$thread_id" ]; then
      echo "Missing thread id" >&2
      usage >&2
      exit 2
    fi
    python3 - "$thread_id" "$message" <<"PY"
import json
import sys
import urllib.request

thread_id, message = sys.argv[1], sys.argv[2]
payload = json.dumps({"thread_id": thread_id, "message": message}).encode()
req = urllib.request.Request(
    "http://localhost:8001/chat",
    data=payload,
    headers={"Content-Type": "application/json"},
    method="POST",
)
with urllib.request.urlopen(req, timeout=60) as response:
    print(response.read().decode())
PY
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
