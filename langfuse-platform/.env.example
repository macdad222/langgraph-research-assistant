# Langfuse self-hosted local development template
# Copy to .env and replace every change-me value before starting.

# Public URL / auth
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=change-me-nextauth-secret
LANGFUSE_PUBLIC_URL=http://localhost:3001
TELEMETRY_ENABLED=false

# Initial admin/login setup
LANGFUSE_INIT_ORG_ID=local-org
LANGFUSE_INIT_ORG_NAME=Local Org
LANGFUSE_INIT_PROJECT_ID=local-project
LANGFUSE_INIT_PROJECT_NAME=Local Project
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=change-me-langfuse-public-key
LANGFUSE_INIT_PROJECT_SECRET_KEY=change-me-langfuse-secret-key
LANGFUSE_INIT_USER_EMAIL=admin@example.local
LANGFUSE_INIT_USER_NAME=Local Admin
LANGFUSE_INIT_USER_PASSWORD=change-me-long-random-password

# Application secrets
SALT=change-me-salt
ENCRYPTION_KEY=change-me-64-hex-character-encryption-key

# Postgres
POSTGRES_VERSION=16
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=langfuse
DATABASE_URL=postgresql://langfuse:change-me-postgres-password@postgres:5432/langfuse

# ClickHouse
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me-clickhouse-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=change-me-redis-password
REDIS_PASSWORD=change-me-redis-password

# MinIO / S3 compatible storage
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio-password

LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=change-me-minio-password
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true

LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=change-me-minio-password
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true

LANGFUSE_S3_BATCH_EXPORT_BUCKET=langfuse
LANGFUSE_S3_BATCH_EXPORT_REGION=auto
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=minio
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=change-me-minio-password
LANGFUSE_S3_BATCH_EXPORT_ENDPOINT=http://minio:9000
LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=http://localhost:9090
LANGFUSE_S3_BATCH_EXPORT_FORCE_PATH_STYLE=true
LANGFUSE_S3_BATCH_EXPORT_PREFIX=exports/
