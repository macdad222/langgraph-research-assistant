# LiteLLM + Postgres local development template
# Copy to .env and replace every change-me value before starting.

LITELLM_MASTER_KEY=change-me-litellm-master-key
LITELLM_SALT_KEY=change-me-litellm-salt-key
VLLM_API_KEY=change-me-upstream-vllm-api-key

POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=litellm
DATABASE_URL=postgresql://litellm:change-me-postgres-password@litellm-db:5432/litellm

UI_USERNAME=admin
UI_PASSWORD=change-me-ui-password
