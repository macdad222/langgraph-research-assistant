# LiteLLM + Postgres local development template
# Copy to .env and replace every change-me value before starting.

LITELLM_MASTER_KEY=change-me-litellm-master-key
LITELLM_SALT_KEY=change-me-litellm-salt-key
VLLM_API_KEY=change-me-upstream-vllm-api-key
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=change-me-openrouter-api-key
ANTHROPIC_API_KEY=change-me-anthropic-api-key
XAI_API_KEY=change-me-xai-api-key

POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=litellm
# LiteLLM runs with host networking in the Linux deployment template.
# Postgres is published only on the host loopback interface.
DATABASE_URL=postgresql://litellm:change-me-postgres-password@127.0.0.1:5433/litellm

UI_USERNAME=admin
UI_PASSWORD=change-me-ui-password
